# Copy to .env (gitignored). Never commit real values. No keys are needed for the public market-data stream.
LIVE_ENABLED=false
CREW_LIVE_MARKET_DATA=true
CREW_LIVE_MARKET_SYMBOLS=BTCUSDT,ETHUSDT
CREW_OWNER_TOKEN=
CREW_OPERATOR_TOKEN=
CREW_VIEWER_TOKEN=
CREW_APPROVAL_HMAC_KEY=
# Optional TOTP for owner actions (approve / mode / config). Leave empty to disable.
CREW_OWNER_TOTP_SECRET=
# Optional free Postgres (Neon/Supabase) for ledger + shared memory. Empty = SQLite.
DATABASE_URL=
POSTGRES_PASSWORD=
# Optional, advisory-only LLM gateway (JEV notes). Empty = NOT CONFIGURED.
OPENROUTER_API_KEY=
KILOCODE_API_KEY=
KILOCODE_BASE_URL=
GROQ_API_KEY=
GROQ_MODEL=
CLINE_API_KEY=
CLINE_MODEL=
